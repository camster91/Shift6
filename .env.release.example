# Public release inputs only. Do not put secrets in this file.
EXPO_PUBLIC_ENVIRONMENT=production

# Choose guest-only or connected.
SHIFT6_RELEASE_MODE=guest-only

# Leave blank for guest-only. Connected releases require a public HTTPS API.
EXPO_PUBLIC_API_BASE_URL=

SHIFT6_PRIVACY_POLICY_URL=
SHIFT6_SUPPORT_URL=

# Account creation may ship only in connected mode with a public deletion resource.
SHIFT6_ACCOUNT_CREATION_ENABLED=false
SHIFT6_ACCOUNT_DELETION_URL=

# Provider-backed Coach remains optional. If enabled, record the completed provider/privacy review.
SHIFT6_REMOTE_COACH_ENABLED=false
SHIFT6_COACH_PROVIDER_REVIEW_REF=

# Analytics and crash reporting may remain disabled. If enabled, record the completed provider/privacy review.
SHIFT6_ANALYTICS_ENABLED=false
SHIFT6_ANALYTICS_REVIEW_REF=
SHIFT6_CRASH_REPORTING_ENABLED=false
SHIFT6_CRASH_REPORTING_REVIEW_REF=

# Required evidence from the exact signed release candidate.
SHIFT6_NETWORK_AUDIT_REF=
