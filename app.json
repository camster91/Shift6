{
  "expo": {
    "name": "SHIFT6",
    "slug": "shift6",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "shift6",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shift6.app"
    },
    "android": {
      "package": "com.shift6.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
