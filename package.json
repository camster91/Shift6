{
  "name": "shift6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{json,js,cjs,mjs}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{json,js,cjs,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "doctor": "expo-doctor",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:release-config": "node scripts/validate-release-config.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "export:web": "expo export --platform web",
    "export:all": "expo export --platform all",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run doctor && npm run validate:assets && npm run check:secrets && npm run validate:release-config && npm audit --omit=dev --audit-level=high && npm test -- --ci && npm run export:all",
    "validate:release-ready": "node scripts/validate-release-ready.mjs && node scripts/validate-release-content.mjs && node scripts/validate-release-assets.mjs",
    "validate:release-assets": "node scripts/validate-release-assets.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@kingstinct/react-native-healthkit": "^15.1.0",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "~29.5.14",
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.2",
    "eslint": "^10.10.0",
    "expo-doctor": "^1.20.4",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
